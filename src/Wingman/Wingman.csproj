<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>wingman</AssemblyName>
    <Version>0.0.0-dev</Version>
    <!-- The version flag prints the plain version, not version+commit hash. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>..\..\assets\wingman.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Publish output is a self-contained, untrimmed single file. Native AOT and trimming are
    both off because Wingman.Core's System.Text.Json calls are reflection based (IL2026,
    IL3050), and TreatWarningsAsErrors turns those analyzer warnings into build failures.
    These properties apply only when a runtime identifier is given, so a plain dotnet build,
    run, or test keeps the framework-dependent layout.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    PublishReadyToRun was tried for issue #81 and measured worse, not better: warm "wingman
    version" startup went from ~233ms to ~443ms (a compressed single-file publish has to decompress
    the much larger R2R native code sections on every launch, which costs more than the JIT time it
    saves for an app this small), and the exe grew about 18%. Left out on purpose; do not re-add
    without re-measuring against a compressed single-file publish specifically.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Wingman.Cli\Wingman.Cli.csproj" />
    <ProjectReference Include="..\Wingman.Core\Wingman.Core.csproj" />
    <ProjectReference Include="..\Wingman.Tui\Wingman.Tui.csproj" />
    <ProjectReference Include="..\Wingman.Windows\Wingman.Windows.csproj" />
  </ItemGroup>

</Project>
