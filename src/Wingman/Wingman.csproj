<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>wingman</AssemblyName>
    <Version>0.0.0-dev</Version>
    <!-- The version flag prints the plain version, not version+commit hash. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>..\..\assets\wingman.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Publish output is a self-contained, untrimmed single file. Native AOT and trimming are
    both off because Wingman.Core's System.Text.Json calls are reflection based (IL2026,
    IL3050), and TreatWarningsAsErrors turns those analyzer warnings into build failures.
    These properties apply only when a runtime identifier is given, so a plain dotnet build,
    run, or test keeps the framework-dependent layout.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    ReadyToRun is off: with EnableCompressionInSingleFile, its larger native code sections are
    decompressed on every launch, which costs more than the JIT time it saves for an app this size
    (warm start about 440ms versus 230ms, exe about 18% larger). Re-measure against a compressed
    single-file publish before turning it on.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Wingman.Cli\Wingman.Cli.csproj" />
    <ProjectReference Include="..\Wingman.Core\Wingman.Core.csproj" />
    <ProjectReference Include="..\Wingman.Tui\Wingman.Tui.csproj" />
    <ProjectReference Include="..\Wingman.Windows\Wingman.Windows.csproj" />
  </ItemGroup>

</Project>
